{
  "name": "studentsbudget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:https": "next build && node scripts/start-https.mjs",
    "cert:https": "node scripts/make-cert.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c e2e-real/playwright.config.ts",
    "test:e2e:live": "playwright test -c e2e-live/playwright.config.ts",
    "test:leak-check": "node e2e-live/leak-check.mjs",
    "test:offline": "playwright test -c playwright.offline.config.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "test:db": "supabase test db",
    "test:contract": "vitest run .contract.test --no-file-parallelism",
    "test:red-green": "node testkit/red-green.mjs --mutations e2e/mutations",
    "mcp": "node mcp/server.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@protomaps/basemaps": "5.7.2",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/speed-insights": "2.1.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.8.0",
    "shadcn": "4.21.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.5",
    "maplibre-gl": "6.16.0",
    "pmtiles": "4.5.0",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
