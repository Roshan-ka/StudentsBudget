# Copy to .env.local (git-ignored) and fill in from Supabase: Project Settings → API Keys.
# Left out, the app runs as in P1: local only, with no account UI.
# The publishable key is meant for the browser; never put a secret key (sb_secret_…) here.
# The values are built into the app, so rebuild or restart `npm run dev` after changing them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for the local MCP server (mcp/, see README): the account its budget_overview tool signs in as, read-only.
# Use a test account. The app never reads these, and without the NEXT_PUBLIC_ prefix they never reach the browser.
# Restart the server (in Claude Code: /mcp) after changing them.
STUDENTSBUDGET_MCP_EMAIL=
STUDENTSBUDGET_MCP_PASSWORD=
