{
  "format": 0,
  "mutations": [
    {
      "name": "a discount's source line leaves out its checked date",
      "file": "src/features/discounts/discounts-view.tsx",
      "find": "after={t.common.source.checked(formatDate(own.checked))}",
      "replace": "after=\"\"",
      "expect": {
        "e2e/discounts.spec.ts": [
          "discount-source-line"
        ]
      }
    },
    {
      "name": "Still works shows no thumbs-up",
      "file": "src/features/discounts/discounts-view.tsx",
      "find": "<ThumbsUpIcon aria-hidden=\"true\" className=\"size-5\" />",
      "replace": "",
      "expect": {
        "e2e/discounts.spec.ts": [
          "upvote-icon"
        ]
      }
    },
    {
      "name": "Still works shows its word beside the thumbs-up",
      "file": "src/features/discounts/discounts-view.tsx",
      "find": "<ThumbsUpIcon aria-hidden=\"true\" className=\"size-5\" />",
      "replace": "<ThumbsUpIcon aria-hidden=\"true\" className=\"size-5\" />\n                    {text.votes.works}",
      "expect": {
        "e2e/discounts.spec.ts": [
          "upvote-icon-only"
        ]
      }
    },
    {
      "name": "the thumbs-up button loses its 44 px size",
      "file": "src/features/discounts/discounts-view.tsx",
      "find": "className=\"size-11 p-0\"",
      "replace": "className=\"p-0\"",
      "expect": {
        "e2e/discounts.spec.ts": [
          "upvote-size"
        ]
      }
    },
    {
      "name": "Outdated shows no thumbs-down",
      "file": "src/features/discounts/discounts-view.tsx",
      "find": "<ThumbsDownIcon aria-hidden=\"true\" />",
      "replace": "",
      "expect": {
        "e2e/discounts.spec.ts": [
          "outdated-icon"
        ]
      }
    },
    {
      "name": "a discount says its checked date twice again",
      "file": "src/features/discounts/discounts-view.tsx",
      "find": "{(own === null || f.lastConfirmed !== own.checked) && (",
      "replace": "{true && (",
      "expect": {
        "e2e/discounts.spec.ts": [
          "no-repeated-date"
        ]
      }
    }
  ]
}
