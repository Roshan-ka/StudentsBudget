{
  "format": 0,
  "mutations": [
    {
      "name": "an account card's kind tile tells a screen reader nothing",
      "file": "src/features/accounts/accounts-panel.tsx",
      "find": "label={text.kinds[account.kind]}",
      "replace": "label={undefined}",
      "expect": {
        "e2e/accounts.spec.ts": [
          "kind-tile"
        ]
      }
    },
    {
      "name": "an account card drops its currency tag",
      "file": "src/features/accounts/accounts-panel.tsx",
      "find": "<span className={TAG}>{account.currency}</span>",
      "replace": "{null}",
      "expect": {
        "e2e/accounts.spec.ts": [
          "currency-tag"
        ]
      }
    },
    {
      "name": "the Settings list's cards touch, as one block",
      "file": "src/features/settings/settings-links.tsx",
      "find": "<ul className=\"flex flex-col gap-3\">",
      "replace": "<ul className=\"flex flex-col\">",
      "expect": {
        "e2e/accounts.spec.ts": [
          "settings-cards-apart"
        ]
      }
    },
    {
      "name": "the Settings list's Profile tile loses its tint",
      "file": "src/features/settings/settings-links.tsx",
      "find": "tint={categoryTint('food')}",
      "replace": "tint=\"transparent\"",
      "expect": {
        "e2e/accounts.spec.ts": [
          "settings-tile-tint"
        ]
      }
    }
  ]
}
