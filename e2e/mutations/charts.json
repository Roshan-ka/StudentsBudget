{
  "format": 0,
  "mutations": [
    {
      "name": "a chart's style switch sits under its heading's line again",
      "file": "src/features/charts/chart-parts.tsx",
      "find": "        {action}\n      </div>\n      {children}",
      "replace": "      </div>\n      {action}\n      {children}",
      "expect": {
        "e2e/charts.spec.ts": [
          "switch-in-heading-line"
        ]
      }
    },
    {
      "name": "the style buttons show no icon",
      "file": "src/features/charts/chart-parts.tsx",
      "find": "<Icon aria-hidden=\"true\" className=\"size-5\" />",
      "replace": "<Icon aria-hidden=\"true\" className=\"hidden\" />",
      "expect": {
        "e2e/charts.spec.ts": [
          "style-icons"
        ]
      }
    },
    {
      "name": "Charts without a plan loses the empty card's line",
      "file": "src/features/charts/charts-view.tsx",
      "find": "        title={t.common.noPlanYet}\n",
      "replace": "        title={null}\n",
      "expect": {
        "e2e/charts.spec.ts": [
          "empty-card-title"
        ]
      }
    },
    {
      "name": "the plot keeps a fixed band for the key again",
      "file": "src/features/charts/bars.tsx",
      "find": "  const plotHeight = rows.length * ROW_HEIGHT + 2 * MARGIN_Y;\n",
      "replace": "  const plotHeight = rows.length * ROW_HEIGHT + 2 * MARGIN_Y + (withPlanned ? 28 : 0);\n",
      "expect": {
        "e2e/charts.spec.ts": [
          "bars-key-own-space"
        ]
      }
    }
  ]
}
