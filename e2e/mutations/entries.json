{
  "format": 0,
  "mutations": [
    {
      "name": "an empty month no longer says where to log",
      "file": "src/features/entries/entries-list.tsx",
      "find": "{text.nothingYetHint}",
      "replace": "{null}",
      "expect": {
        "e2e/entries.spec.ts": [
          "empty-hint"
        ]
      }
    },
    {
      "name": "an entry card drops its account",
      "file": "src/features/entries/entries-list.tsx",
      "find": "      : accountName(entry.accountId),\n",
      "replace": "      : null,\n",
      "expect": {
        "e2e/entries.spec.ts": [
          "entry-account"
        ]
      }
    },
    {
      "name": "the entry form's amount leaves the accent card",
      "file": "src/features/entries/entry-form.tsx",
      "find": "<Card variant=\"accent\" className=\"gap-1.5\">",
      "replace": "<Card className=\"gap-1.5\">",
      "expect": {
        "e2e/entries.spec.ts": [
          "amount-accent"
        ]
      }
    },
    {
      "name": "the entry form's category chips show no icon",
      "file": "src/features/tips/category-chip.tsx",
      "find": "      <Icon aria-hidden=\"true\" />\n      <span className=\"min-w-0",
      "replace": "      <span className=\"min-w-0",
      "expect": {
        "e2e/entries.spec.ts": [
          "category-chip-icon"
        ]
      }
    },
    {
      "name": "quick add forgets its food and drink words",
      "file": "src/features/entries/category-words.ts",
      "find": "  return suggestCategory(note, history) ?? wordCategory(note);\n",
      "replace": "  return suggestCategory(note, history);\n",
      "expect": {
        "e2e/entries.spec.ts": [
          "word-list-category"
        ]
      }
    },
    {
      "name": "a letter typed after an asked line joins it",
      "file": "src/features/entries/quick-add-field.tsx",
      "find": "lineAfterQuestion(text, event.target.value)",
      "replace": "event.target.value",
      "expect": {
        "e2e/entries.spec.ts": [
          "next-line-after-question"
        ]
      }
    },
    {
      "name": "an asked line the next one replaces goes without a word again",
      "file": "src/features/entries/quick-add-field.tsx",
      "find": "              if (left !== null) setDropped(left);\n",
      "replace": "",
      "expect": {
        "e2e/entries.spec.ts": [
          "dropped-line-said"
        ]
      }
    },
    {
      "name": "quick add's category chips lose their tint",
      "file": "src/features/tips/category-chip.tsx",
      "find": "      data-category={categoryId}\n      style={{ backgroundColor: categoryTint(categoryId) }}\n",
      "replace": "      data-category={categoryId}\n",
      "expect": {
        "e2e/entries.spec.ts": [
          "chips-tinted"
        ]
      }
    },
    {
      "name": "More stays on screen after it's tapped",
      "file": "src/features/entries/quick-add-field.tsx",
      "find": "        {showMore ? (\n          MORE_CATEGORIES.map(chip)\n        ) : (",
      "replace": "        {showMore && MORE_CATEGORIES.map(chip)}\n        {(",
      "expect": {
        "e2e/entries.spec.ts": [
          "more-goes"
        ]
      }
    },
    {
      "name": "the focus stays where More was",
      "file": "src/features/entries/quick-add-field.tsx",
      "find": "    if (!showMore) return;\n",
      "replace": "    if (showMore || !showMore) return;\n",
      "expect": {
        "e2e/entries.spec.ts": [
          "more-focus"
        ]
      }
    },
    {
      "name": "quick add reads the date out of the line but saves it today",
      "file": "src/features/entries/quick-add-provider.ts",
      "find": "    const date = dated === undefined ? {} : { date: dated.date };\n",
      "replace": "    const date = {};\n",
      "expect": {
        "e2e/entries.spec.ts": [
          "line-date"
        ]
      }
    },
    {
      "name": "\"last\" before a weekday is not read, so last friday is today",
      "file": "src/features/entries/quick-add-date.ts",
      "find": "  en: ['last'],\n",
      "replace": "  en: [],\n",
      "expect": {
        "e2e/entries.spec.ts": [
          "line-weekday"
        ]
      }
    },
    {
      "name": "quick add reads number words in English only again",
      "file": "src/features/entries/quick-add-provider.ts",
      "find": "    const typed = numberWordsToDigits(text, lang);\n",
      "replace": "    const typed = numberWordsToDigits(text, 'en');\n",
      "expect": {
        "e2e/entries.spec.ts": [
          "number-words"
        ]
      }
    }
  ]
}
