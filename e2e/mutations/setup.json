{
  "format": 0,
  "mutations": [
    {
      "name": "a source line leaves out its checked date",
      "file": "src/features/setup/steps/range-source.tsx",
      "find": "after={t.common.source.checked(formatDate(range.checked))}",
      "replace": "after=\"\"",
      "expect": {
        "e2e/setup.spec.ts": [
          "rent-source-line"
        ]
      }
    },
    {
      "name": "the rent card folds its source line away again",
      "file": "src/features/setup/steps/fixed.tsx",
      "find": "{rentRange && <RangeSource range={rangeIn(rentRange, lang)} />}",
      "replace": "{rentRange && (\n            <details open>\n              <summary>Source</summary>\n              <RangeSource range={rangeIn(rentRange, lang)} />\n            </details>\n          )}",
      "expect": {
        "e2e/setup.spec.ts": [
          "rent-source-no-fold"
        ]
      }
    }
  ]
}
