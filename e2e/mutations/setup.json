{
  "format": 0,
  "mutations": [
    {
      "name": "a source line leaves out its checked date",
      "file": "src/features/setup/steps/range-source.tsx",
      "find": "after={t.common.source.checked(formatDate(range.checked))}",
      "replace": "after=\"\"",
      "expect": {
        "e2e/setup.spec.ts": [
          "rent-source-line"
        ]
      }
    },
    {
      "name": "the rent card folds its source line away again",
      "file": "src/features/setup/steps/fixed.tsx",
      "find": "{rentRange && <RangeSource range={rangeIn(rentRange, lang)} />}",
      "replace": "{rentRange && (\n            <details open>\n              <summary>Source</summary>\n              <RangeSource range={rangeIn(rentRange, lang)} />\n            </details>\n          )}",
      "expect": {
        "e2e/setup.spec.ts": [
          "rent-source-no-fold"
        ]
      }
    },
    {
      "name": "a category card's label goes back to the Label's flex, and a long word runs under the field",
      "file": "src/features/setup/steps/amount-field.tsx",
      "find": "className=\"block min-w-0 flex-1 basis-20",
      "replace": "className=\"min-w-0 flex-1 basis-20",
      "expect": {
        "e2e/setup.spec.ts": [
          "long-label-wraps"
        ]
      }
    },
    {
      "name": "BAföG goes back under the fold of a new setup",
      "file": "src/data/categories.ts",
      "find": "  'income-bafoeg',\n  'income-sperrkonto',",
      "replace": "  'income-sperrkonto',",
      "expect": {
        "e2e/setup.spec.ts": [
          "bafoeg-field"
        ]
      }
    }
  ]
}
