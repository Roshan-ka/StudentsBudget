          "import-tile-tint"
        ]
      }
    },
    {
      "name": "the export's tile loses its tint",
      "file": "src/features/export/export-entries.tsx",
      "find": "tint={categoryTint('eating-out')}",
      "replace": "tint=\"transparent\"",
      "expect": {
        "e2e/import.spec.ts": [
          "export-tile-tint"
        ]
      }
    }
  ]
}
