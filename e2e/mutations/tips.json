{
  "format": 0,
  "mutations": [
    {
      "name": "a tip's source line leaves out its checked date",
      "file": "src/features/tips/tips-view.tsx",
      "find": "      {' · '}\n      {t.common.source.checked(formatDate(words.checked))}\n",
      "replace": "",
      "expect": {
        "e2e/tips.spec.ts": [
          "tip-source-line"
        ]
      }
    },
    {
      "name": "a category chip shows no icon",
      "file": "src/features/tips/category-chip.tsx",
      "find": "      {Icon !== null && <Icon aria-hidden=\"true\" />}\n",
      "replace": "",
      "expect": {
        "e2e/tips.spec.ts": [
          "chip-icon"
        ]
      }
    },
    {
      "name": "the pressed chip has no ring",
      "file": "src/features/tips/category-chip.tsx",
      "find": "className=\"aria-pressed:ring-2 aria-pressed:ring-foreground aria-pressed:ring-offset-1 aria-pressed:ring-offset-background\"",
      "replace": "className=\"\"",
      "expect": {
        "e2e/tips.spec.ts": [
          "chip-ring"
        ]
      }
    }
  ]
}
