{
  "$comment": [
    "Which e2e specs a pull request runs (scripts/ci-affected.mjs). A changed module picks the specs of every route whose page imports it, directly or through other modules.",
    "routes: each route (a folder under src/app with a page.tsx, and the manifest) and the specs that open it. 'all' marks a route every spec passes through: setup (18 of 24 specs start in the wizard), Home (where setup ends; it holds the check-in, badges, reveal and quick-add cards) and Settings (the panels of eight features).",
    "allOnly: specs that open only routes marked 'all', so they run whenever one of those is reached.",
    "offline.spec.ts is never listed: the offline check runs on its own (playwright.offline.config.ts). smoke.spec.ts runs with every list.",
    "The unit tests fail when a route or a spec is missing here."
  ],
  "routes": {
    "/": "all",
    "/badges": ["axe", "badges", "language-tour", "profile", "reflow", "theme"],
    "/charts": ["axe", "charts", "demo-backup", "demo-scenarios", "language-tour", "page-focus", "reflow", "theme"],
    "/check-in": ["axe", "badges", "check-in", "demo-scenarios", "language-tour", "reflow", "swaps", "theme"],
    "/entries": ["accounts", "axe", "backup", "charts", "check-in", "demo-backup", "demo-scenarios", "entries", "home", "language-tour", "reflow", "theme"],
    "/entries/new": ["accounts", "axe", "check-in", "entries", "language-tour", "reflow", "theme"],
    "/manifest.webmanifest": ["axe", "smoke"],
    "/reveal": ["axe", "demo-scenarios", "language-tour", "reflow", "reveal", "setup", "theme"],
    "/settings": "all",
    "/settings/accounts": ["accounts", "axe", "backup", "demo-scenarios", "entries", "home", "insecure-origin", "language-tour", "overdrawn", "privacy-notes", "recurring", "reflow", "theme"],
    "/settings/appearance": ["axe", "language-tour", "reflow", "theme"],
    "/settings/backup": ["axe", "backup", "language-tour", "profile", "reflow", "theme"],
    "/settings/plan": ["accounts", "axe", "language-tour", "profile", "recurring", "reflow", "setup", "theme"],
    "/settings/profile": ["axe", "language-tour", "linking", "page-focus", "profile", "reflow", "theme", "two-step"],
    "/settings/account": ["account", "account-deletion", "axe", "change-password", "discount-confirmations", "email-codes", "hacks-feed", "hacks-post", "hacks-translate", "hacks-votes", "language-tour", "linking", "moderation", "passkeys", "posting-name", "privacy-notes", "reflow", "theme", "two-step"],
    "/settings/moderation": ["axe", "language-tour", "moderation", "reflow", "theme"],
    "/setup": "all",
    "/tips": ["axe", "discount-confirmations", "discounts", "hacks-feed", "hacks-post", "hacks-translate", "hacks-votes", "language-tour", "privacy-notes", "reflow", "theme", "tips"]
  },
  "allOnly": ["dictation", "language"]
}
