# Obsidian: the vault is docs/; a vault opened at the repo root stays local
/.obsidian/

# Claude Code: personal permission overrides stay on this machine
.claude/settings.local.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
# red before green (testkit/red-green.mjs): its reports and the original of a file it mutates
/.red-green/
# saved sign-ins of the real-server e2e (e2e-real/, storageState): as good as a password while they last
/playwright/.auth/
# the real-server e2e's HTML report on CI
/playwright-report-real/
# the real-server e2e's result kinds (testkit/result-kinds-reporter.mjs), for the CI job summary
/result-kinds-real.md
# the random clicker's step logs (e2e-real/monkey.spec.ts), to replay a walk
/.monkey/
# the live smoke's leak check (e2e-live/leak-check.mjs): its throwaway account's email and key
/.leak-check/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the template with the variable names only, no values
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# HTTPS certificate and key for phone testing (npm run cert:https): never committed
/certs/
